# Copia este archivo como ".env.demo" y completa los datos de tu cuenta DEMO.
# ".env.demo" está en .gitignore: no lo subas a Git.

MT5_LOGIN=12345678
MT5_PASSWORD=cambia-esto
MT5_SERVER=NombreDelBroker-Demo

# Ruta del terminal (opcional si MetaTrader 5 ya está abierto con esa cuenta):
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Alertas por Telegram (fase 3). Crea el bot con @BotFather y pega aquí su token.
# TELEGRAM_CHAT_ID se obtiene con:  py -m forexplat telegram-setup --profile demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
